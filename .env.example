# Supabase (opcional - se vazio, usa armazenamento local IndexedDB)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Hugging Face (gratuito - token para reconhecimento visual)
VITE_HF_TOKEN=

# Google Gemini (free tier - visão/reconhecimento alternativo)
VITE_GEMINI_KEY=

# Serviços 100% gratuitos usados pelo app:
# - Tesseract.js (OCR local, sem chave)
# - Open Food Facts (código de barras, sem chave)
# - Wikimedia Commons (imagens de referência, sem chave)
# - Pollinations.ai (geração de imagem, sem chave)
# Nenhuma API paga (OpenAI, Bing Visual Search etc.) é utilizada.
